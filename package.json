{
    "name": "ticrafter",
    "version": "0.1.0",
    "private": true,
    "description": "Fleet of autonomous Minecraft 1.20.1 agents.",
    "type": "module",
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.4.2"
    },
    "workspaces": [
        "apps/*",
        "packages/*",
        "tools/*"
    ],
    "scripts": {
        "bootstrap": "bun tools/bootstrap/bootstrap.mjs",
        "bootstrap:check": "bun tools/bootstrap/bootstrap.mjs --check",
        "bootstrap:clean": "bun tools/bootstrap/bootstrap.mjs --clean",
        "bootstrap:python": "bun tools/bootstrap/bootstrap.mjs --no-server",
        "bootstrap:server": "bun tools/bootstrap/bootstrap.mjs --no-python",
        "validate:graph": "bun tools/architecture/validate-graph.mjs",
        "render:graphs": "bun tools/architecture/render-graphs.mjs",
        "render:svg": "bun tools/architecture/render-svg.mjs",
        "server:start": "bun tools/bootstrap/minecraft-server.mjs start",
        "server:start:accept-eula": "bun tools/bootstrap/minecraft-server.mjs start --accept-eula",
        "server:stop": "bun tools/bootstrap/minecraft-server.mjs stop",
        "server:status": "bun tools/bootstrap/minecraft-server.mjs status",
        "bench:laya": "bun tools/laya-bench/benchmark.mjs",
        "bench:laya:fp16": "bun tools/laya-bench/benchmark.mjs --fixture compact --model-dir models/laya-fp16 --provider webgpu",
        "convert:laya:fp16": ".venv/bin/python tools/laya-bench/convert-fp16.py models/laya/receptron--laya-onnx/d42786bdff8a7550316339c5fbf8f46caa83ea1b models/laya-fp16",
        "dev:coordinator": "bun apps/coordinator/src/main.ts",
        "dev:bot": "bun apps/bot/src/main.ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "test": "bun test"
    },
    "dependencies": {
        "@receptron/laya": "0.2.0",
        "mineflayer": "4.39.0",
        "mineflayer-collectblock": "1.6.0",
        "mineflayer-crafting-util": "0.5.0",
        "mineflayer-pathfinder": "2.4.5",
        "pino": "10.4.0",
        "prismarine-block": "1.23.0",
        "prismarine-chunk": "1.41.0",
        "prismarine-schematic": "1.3.0",
        "prismarine-world": "3.7.0",
        "ws": "8.22.2",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@mermaid-js/mermaid-cli": "12.2.0",
        "@types/bun": "1.4.4",
        "@types/node": "24.19.2",
        "@types/ws": "8.18.2",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.2"
    }
}
